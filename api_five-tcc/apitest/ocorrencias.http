@baseUrl = http://localhost:3000

GET {{baseUrl}}/ocorrencias/listarOcorrencia

###
GET  {{baseUrl}}/ocorrencias/listarOcorrenciaId/10

###

POST {{baseUrl}}/ocorrencias/abrirOcorrencia
Content-Type: application/json

{
  "ocor_nome": "roteador",
  "ocor_prioridade": "alta",
  "ocor_obs": "Não liga",
  "componente_id": 3,
  "ambiente_id": 2
}

###

PATCH {{baseUrl}}/ocorrencias/editarOcorrencia/3
Content-Type: application/json

{
  "ocor_nome": "Computador não liga",
  "ocor_prioridade": "alta",
  "ocor_obs": "O computador da sala não apresenta sinal de energia",
  "componente_id": 2,
  "ambiente_id": 1
}

###

PATCH {{baseUrl}}/ocorrencias/editarOcorrencia/6
Content-Type: application/json

{
  "ocor_nome": "Computador não liga",
  "ocor_prioridade": "baixa",
  "ocor_obs": "O computador da sala não apresenta sinal de energia",
  "componente_id": 2,
  "ambiente_id": 1
}

