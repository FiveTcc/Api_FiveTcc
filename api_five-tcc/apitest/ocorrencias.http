PATCH {{baseUrl}}/ocorrencias/10/adicionarObservacao
Content-Type: application/json

{
    "ocor_obs": "Foi realizada uma tentativa de reparo no computador."
}

### Associar componente a ocorrencia
PATCH {{baseUrl}}/ocorrencias/16/associarComponente
Content-Type: application/json

{
  "id_comp": 2
}

### Associar ambiente a ocorrencia
PATCH {{baseUrl}}/ocorrencias/16/associarAmbiente
Content-Type: application/json

{
  "id_amb": 17
}


############################# Filtros ####################################

### Filtrar ocorrências por componente
GET {{baseUrl}}/ocorrencias/buscarPorNome?nomeOcor=computador

### Filtrar ocorrências por ambiente
GET {{baseUrl}}/ocorrencias/buscarPorAmbiente?nomeAmb=Sala


### Filtrar ocorrências por componente
GET {{baseUrl}}/ocorrencias/buscarPorComponente?nomeComp=roteador

### Filtrar ocorrências por status
GET {{baseUrl}}/ocorrencias/buscarPorStatus?status=cancelada

### Filtrar ocorrências por prioridade
GET {{baseUrl}}/ocorrencias/buscarPorPrioridade?prioridade=media

### Filtrar ocorrências por periodo
GET {{baseUrl}}/ocorrencias/buscarPorPeriodo?dataInicio=2026-08-25&dataFim=2026-08-25