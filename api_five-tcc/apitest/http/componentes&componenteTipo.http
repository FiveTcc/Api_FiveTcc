@baseUrl = {{$dotenv BASE_URL}}
@email = {{$dotenv LOGIN_EMAIL}}
@senha = {{$dotenv LOGIN_SENHA}}
@Token = {{login.response.body.accessToken}}

### ========================================
### LOGIN
### ========================================

### Login (clique aqui primeiro)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "user_email": "{{email}}",
  "user_senha": "{{senha}}"
}

### Renovar token
# @name refresh
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.refreshToken}}"
}


### ======================================================
### COMPONENTES
### ======================================================

### 1. Listar todos os componentes
GET {{baseUrl}}/componentes/listarComponente
Authorization: Bearer: {{Token}}


### 2. Buscar componente por ID
GET {{baseUrl}}/componentes/listarComponenteId/1
Authorization: Bearer: {{Token}}


### 3. Cadastrar componente
POST {{baseUrl}}/componentes/cadastrarComponente
Authorization: Bearer: {{Token}}
Content-Type: application/json

{
  "compo_nome": "Roteador TP-Link",
  "compo_obs": "Roteador do lab 1",
  "compo_ativo": true,
  "compo_tipo_id": 1,
  "id_amb": 1
}


### 4. Atualizar componente
PATCH {{baseUrl}}/componentes/atualizarComponente/1
Authorization: Bearer {{Token}}
Content-Type: application/json

{
  "compo_nome": "PC-01",
  "compo_obs": "computador do lab 1",
  "compo_ativo": false,
  "compo_tipo_id": 1,
  "id_amb": 1
}


### 5. Excluir componente
DELETE {{baseUrl}}/componentes/excluirComponente/1
Authorization: Bearer {{Token}}


### 6. Atualizar status do componente
PATCH {{baseUrl}}/componentes/atualizarStatusComponente/1
Authorization: Bearer {{Token}}


### 7. Associar componente ao ambiente
PATCH {{baseUrl}}/componentes/1/associarComponenteAmbiente
Authorization: Bearer {{Token}}
Content-Type: application/json

{
  "id_amb": 1
}


### ======================================================
### FILTROS DE COMPONENTES
### ======================================================

### 8. Filtrar componentes por ambiente
GET {{baseUrl}}/componentes/buscarPorAmbiente?nomeAmb=Laboratorio
Authorization: Bearer {{Token}}


### 9. Filtrar componentes por tipo
GET {{baseUrl}}/componentes/buscarPorTipo?tipo=hardware
Authorization: Bearer {{Token}}

### 10. Filtrar componentes por nome
GET {{baseUrl}}/componentes/buscarPorNome/Roteador
Authorization: Bearer {{Token}}


### ======================================================
### COMPONENTES TIPO
### ======================================================

### 11. Listar todos os tipos componentes
GET {{baseUrl}}/componentes-tipo/listarComponenteTipo
Authorization: Bearer {{Token}}


### 12. Buscar tipo de componente por ID
GET {{baseUrl}}/componentes-tipo/listarComponenteTipoId/3
Authorization: Bearer {{Token}}


### 13. Cadastrar tipo de componente
POST {{baseUrl}}/componentes-tipo/cadastrarComponenteTipo
Authorization: Bearer {{Token}}
Content-Type: application/json

{
  "compo_tipo": "software"
}


### 14. Atualizar tipo de componente
PATCH {{baseUrl}}/componentes-tipo/atualizarComponenteTipo/1
Authorization: Bearer {{Token}}
Content-Type: application/json

{
  "compo_tipo": "hardware"
}


### 15. Excluir tipo de componente
DELETE {{baseUrl}}/componentes-tipo/excluirComponenteTipo/5
Authorization: Bearer {{Token}}